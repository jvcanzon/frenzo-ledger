    "@capacitor/status-bar": "^6.0.2",
    "@supabase/supabase-js": "^2.49.0",
    "jspdf": "^2.5.1",
    "jszip": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
